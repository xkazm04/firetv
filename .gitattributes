* text=auto eol=lf

# Shell scripts must stay LF or they break on Linux CI runners.
gradlew text eol=lf
*.sh text eol=lf

# PowerShell is happier with CRLF on Windows.
*.ps1 text eol=crlf

*.jar binary
*.png binary
*.mp4 binary

# Track recipes and excluded proposals are byte-hashed authoring evidence.
# Keep their original bytes when moving or checking them out.
deathride/tracks/candidates/recipes/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/tracks/excluded/owner-2026-10-04/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Installed rejected CSVs retain their original empty-table trailing lines and byte hashes.
deathride/tracks/excluded/owner-2026-10-04/rejected/runtime/tracks/*.csv -whitespace

# Art provenance records hash exact bytes, including their original line endings.
# Preserve those bytes across checkout; CRLF at line ends is intentional evidence.
deathride/art/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/tools/art/surface-lab/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/tools/art/surface_run.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/tools/art/fusion*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/tools/art/part3*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/assets/phase2-fusion/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/assets/phase2-hud/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/assets/phase2-states/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/evidence/hud/h3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
deathride/evidence/perf/** -text -whitespace
# Raw ADB readbacks retain device CR characters and aligned trailing columns.
deathride/art/surface-lab/device/**/*.txt -whitespace
deathride/art/surface-lab/device/*.txt -whitespace
